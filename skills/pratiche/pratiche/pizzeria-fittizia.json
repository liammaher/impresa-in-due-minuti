{
 "procedure": "napoli/comune/scia-somministrazione-alimenti-bevande",
 "title": "SCIA: apertura di un bar o ristorante (somministrazione) con notifica sanitaria, SUAP Napoli",
 "yours": [
  "Apri la bozza in Pratiche in bozza ({{ask.descrizione}}) e confrontala con questa pagina",
  "Spunta tu le sette dichiarazioni: consapevolezza (artt. 46-47), informativa privacy, requisiti di onorabilità e professionali, altre dichiarazioni, art. 6 Reg. 852/2004, tasse comunali, art. 75 DPR 445/2000",
  "Paga con pagoPA, nella schermata del pagamento, i diritti di segreteria ({{ask.diritti_euro}} €) e la tariffa forfettaria ASL",
  "Allega, firmate digitalmente (.p7m): la planimetria quotata del locale e la ricevuta della tariffa ASL",
  "Firma e invia (Firma e invio); conserva la ricevuta"
 ],
 "groups": {
  "extras": {
   "question": "Quali di queste cose valgono per l'attività? Spunta quelle vere, anche nessuna."
  }
 },
 "asks": {
  "zona_tutelata": {
   "group": "extras",
   "type": "yes_no",
   "item": "È nel centro storico: l'area UNESCO o la sua zona cuscinetto",
   "why": "Dal 25 luglio 2026 un'apertura lì richiede un'autorizzazione, non una SCIA, e per ora preparo solo la SCIA."
  },
  "alcolici": {
   "group": "extras",
   "type": "yes_no",
   "item": "Venderà bevande alcoliche, birra e vino compresi",
   "why": "La vendita di alcolici aggiunge la comunicazione alle Dogane: un caso che non preparo ancora."
  },
  "musica": {
   "group": "extras",
   "type": "yes_no",
   "item": "Avrà musica o un impianto audio",
   "why": "La musica aggiunge la documentazione di impatto acustico: un caso che non preparo ancora."
  },
  "insegna_esterna": {
   "group": "extras",
   "type": "yes_no",
   "item": "Avrai un'insegna esterna",
   "why": "Un'insegna esterna aggiunge la SCIA dell'insegna: un caso che non preparo ancora."
  },
  "centro_commerciale": {
   "group": "extras",
   "type": "yes_no",
   "item": "È dentro un centro commerciale"
  },
  "stagionale": {
   "group": "extras",
   "type": "yes_no",
   "item": "Aprirà solo per una parte dell'anno (stagionale)"
  },
  "insegna": {
   "type": "text",
   "question": "Il nome sull'insegna?"
  },
  "superficie_somministrazione_mq": {
   "type": "number",
   "question": "Quanti m² è l'area dove i clienti mangiano e bevono? (non l'intero locale)"
  },
  "descrizione": {
   "type": "text",
   "question": "Un nome per la bozza, in Pratiche in bozza del portale",
   "default": "SCIA somministrazione - {{business.denominazione}}"
  },
  "diritti_euro": {
   "type": "number",
   "question": "I diritti del SUAP, in euro",
   "default": "120",
   "why": "La voce della tabella 2026 per un bar o ristorante con notifica sanitaria, fuori dalle zone tutelate."
  }
 },
 "supports": [
  {
   "value": "{{business.forma_giuridica}}",
   "in": [
    "ditta_individuale"
   ],
   "else": "Per ora la preparo solo per una ditta individuale: la SCIA di una società ha schermate che non compilo ancora."
  },
  {
   "when": "{{ask.zona_tutelata|not}}",
   "else": "Nel centro storico un'apertura richiede un'autorizzazione, non una SCIA: non la preparo ancora."
  },
  {
   "when": "{{ask.alcolici|not}}",
   "else": "La vendita di alcolici aggiunge la comunicazione alle Dogane: non la preparo ancora."
  },
  {
   "when": "{{ask.musica|not}}",
   "else": "Musica o impianto audio aggiungono la documentazione di impatto acustico: non la preparo ancora."
  },
  {
   "when": "{{ask.insegna_esterna|not}}",
   "else": "Un'insegna esterna aggiunge la SCIA dell'insegna: non la preparo ancora."
  }
 ],
 "start": "https://suap.impresainungiorno.gov.it/fnsuap/cmd/create?comune=F839",
